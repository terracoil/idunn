# Bytecode: rebuilt on every import, so never worth a diff
__pycache__/
*.py[cod]

# The in-project Poetry venv; the per-interpreter test venvs live under tmp/
.venv/

# Packaging output from `poetry build` and older setuptools runs
dist/
build/
*.egg-info/
.egg*

# Scratch space: tool caches, tmp/venv-3.11 and tmp/venv-3.14. Only the empty tmp/.gitkeep is
# tracked, so a fresh clone already has the directory the caches are configured to use.
tmp/*
!tmp/.gitkeep

# Caches and reports. Pytest, Ruff and mypy are configured to write under tmp/; these catch runs
# from anywhere else, such as an IDE.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pre-commit-cache/
.coverage
htmlcov/
reports/
logs
.ipynb_checkpoints

# Per-developer settings: editors, the OS, the pyenv pin and Claude Code
.DS_Store
.idea/
.vscode/
.python-version
.claude/
CLAUDE.local.md
